# PRDCT-11935 at9-04 — the Event Grid subscription's delivery property: subject -> Service Bus Label
# FILE LAST WRITTEN 2026-08-21T03:52:27Z  ·  this stamp is the file's own last-write time; the capture times stated below belong to the
#   measurements themselves, which is why the two can differ when a later round corrected a number.
# captured 2026-08-18T19:36:14Z · onyx branch 153d29c86a
#
# WHY IT MATTERS: every byoc-events subscription rule filters on sys.Label. Without this delivery
# property the Label is empty, no rule matches, and every scanner object is silently never routed —
# a renders-green dead path. So it is asserted on a REAL delivery, not read off the TF.

## 1. The authored TF that creates it (infrastructure @ factory-eval-v32/PRDCT-11935,
##    modules/azure/blob_events_to_servicebus/main.tf):
      delivery_property {
        header_name  = "Label"
        type         = "Dynamic"
        source_field = "subject"
      }

## 2. The live lab subscription built to that same shape (note destination.deliveryAttributeMappings):
{
 "destination": {
  "deliveryAttributeMappings": [
   {
    "name": "Label",
    "sourceField": "subject",
    "type": "Dynamic"
   }
  ],
  "endpointType": "ServiceBusTopic",
  "resourceId": "/subscriptions/b3f77526-827b-4354-9166-bcbff86b9749/resourceGroups/prdct11935-rg/providers/Microsoft.ServiceBus/namespaces/prdct11935bus/topics/byoc-events"
 },
 "eventDeliverySchema": "EventGridSchema",
 "filter": {
  "advancedFilters": null,
  "enableAdvancedFilteringOnArrays": null,
  "includedEventTypes": [
   "Microsoft.Storage.BlobCreated"
  ],
  "isSubjectCaseSensitive": null,
  "subjectBeginsWith": "",
  "subjectEndsWith": ""
 },
 "name": "to-byoc-events"
}

